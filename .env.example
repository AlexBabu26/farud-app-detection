# Copy this file to .env and fill in your values.
# Required for the app to run:

# Django secret (generate a new one for production, e.g. python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=your-django-secret-key-here

# Groq API key (get one at https://console.groq.com/keys)
GROQ_API_KEY=

# LLM model ID for fraud analysis (e.g. llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768)
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: app behavior
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=UTC
LOG_LEVEL=INFO

# Optional: JWT token lifetimes
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Optional: analysis run throttle (per user). Default 10/hour; use higher for dev (e.g. 60/hour)
# ANALYSIS_THROTTLE_RATE=60/hour

# Optional: CSRF trusted origins (comma-separated)
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com
